<view class="profile-page">
  <navigation-bar title="个人资料" back />

  <view class="profile-body" wx:if="{{!loading}}">
    <!-- 头像 -->
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-placeholder-icon">+</text>
        </view>
        <view class="avatar-overlay">
          <text class="avatar-overlay-text">更换头像</text>
        </view>
      </button>
      <text class="avatar-hint">点击上方更换头像</text>
    </view>

    <!-- 昵称 -->
    <view class="name-section">
      <text class="name-label">昵称</text>
      <t-input
        type="nickname"
        placeholder="请输入昵称"
        value="{{nickName}}"
        bind:change="onNickNameChange"
        borderless="{{true}}"
      />
    </view>

    <!-- 保存按钮 -->
    <view class="save-section">
      <t-button theme="primary" size="small" block="{{true}}" shape="round" loading="{{saving}}" bindtap="save">保存</t-button>
    </view>
  </view>

  <!-- 加载 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
