<view class="login-page">
  <!-- 顶部装饰区域 -->
  <view class="login-header">
    <text class="app-name">小嘟干饭</text>
    <text class="app-slogan">每一餐都值得被记录</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <!-- 头像选择 -->
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{!avatarError}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-placeholder-icon">👤</text>
        </view>
        <view class="avatar-overlay">
          <text class="avatar-overlay-text">点击选择头像</text>
        </view>
      </button>
    </view>

    <!-- 昵称输入 -->
    <view class="input-section">
      <t-input
        type="nickname"
        placeholder="请输入昵称"
        value="{{userInfo.nickName}}"
        bind:change="onInputChange"
        borderless="{{true}}"
        clearable="{{false}}"
        placeholder-style="color: #ccc; text-align: center"
        align="center"
      >
      </t-input>
    </view>

    <!-- 确认按钮 -->
    <view class="btn-section">
      <t-button
        theme="primary"
        size="small"
        block="{{true}}"
        disabled="{{!hasUserInfo}}"
        loading="{{loading}}"
        bindtap="onConfirmLogin"
        shape="round"
      >
        进入首页
      </t-button>
    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="login-footer">
    <text class="footer-text">开始你的美食之旅 🍜</text>
  </view>
</view>
