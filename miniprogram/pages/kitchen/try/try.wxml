<view class="try-page">

  <view class="content">
    <scroll-view class="try-scroll" scroll-y>
      <view class="section">
        <view class="section-title">成品照片</view>
        <view class="section-desc">上传你做的菜谱成品图（最多{{maxImages}}张）</view>

        <view class="image-grid">
          <view class="image-item" wx:for="{{images}}" wx:key="*this">
            <image class="preview-image" src="{{item}}" mode="aspectFill" />
            <view class="remove-btn" data-index="{{index}}" bindtap="removeImage">✕</view>
          </view>

          <view class="add-image" wx:if="{{images.length < maxImages}}" bindtap="chooseImage">
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-title">心得（可选）</view>
        <textarea class="note-input" placeholder="分享你的烹饪心得..." value="{{note}}" bindinput="onNoteInput" maxlength="500" />
      </view>
    </scroll-view>

    <view class="submit-area">
      <button class="submit-btn" disabled="{{submitting}}" bindtap="submit">
        {{submitting ? '提交中...' : '完成打卡'}}
      </button>
    </view>
  </view>
</view>
